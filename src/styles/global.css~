:root {
  --tinta: #2b1a33;
  --suave: #6d5b76;
  --papel: #f5f1f7;
  --hoja: #fdfbfe;
  --malva: #b8456f;
  --salvia: #4f6b52;
  --oro: #d9a33f;
  --linea: #ddd3e3;
  --serif: 'Fraunces', Georgia, serif;
  --texto: 'Newsreader', Georgia, serif;
  --mano: 'Caveat', cursive;
}
@media (prefers-color-scheme: dark) {
  :root {
    --tinta: #f1e8f5; --suave: #b9a8c4; --papel: #1c1222; --hoja: #251a2d;
    --malva: #e88fb0; --salvia: #9cc0a0; --linea: #3c2c47;
  }
}
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0; background: var(--papel); color: var(--tinta);
  font: 1.125rem/1.7 var(--texto); -webkit-font-smoothing: antialiased;
}
a { color: var(--malva); text-underline-offset: 3px; }
:focus-visible { outline: 3px solid var(--oro); outline-offset: 3px; border-radius: 4px; }
h1, h2, h3 { font-family: var(--serif); font-weight: 600; line-height: 1.15; margin: 0; letter-spacing: -0.01em; }
main { max-width: 62rem; margin: 0 auto; padding: 2rem 1.25rem 4rem; }

/* Cabecera */
.top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; max-width: 62rem; margin: 0 auto; padding: 1.5rem 1.25rem 0; }
.marca { font-family: var(--serif); font-style: italic; font-size: 1.4rem; color: var(--tinta); text-decoration: none; }
.top nav { display: flex; gap: 1.5rem; }
.top nav a { color: var(--suave); text-decoration: none; padding: .25rem 0; border-bottom: 2px solid transparent; }
.top nav a:hover, .top nav a[aria-current] { color: var(--tinta); border-color: var(--malva); }
.pie { text-align: center; color: var(--suave); padding: 2rem 1rem 3rem; font-family: var(--mano); font-size: 1.4rem; }

/* Portada y encabezados */
.hero { padding: 4rem 0 3rem; max-width: 44rem; }
.hero h1 { font-size: clamp(2.4rem, 7vw, 4.4rem); font-weight: 400; }
.hero p { color: var(--suave); font-size: 1.25rem; margin-top: 1.25rem; max-width: 36rem; }
.encabezado { padding: 3rem 0 1.5rem; }
.encabezado h1 { font-size: clamp(2.2rem, 6vw, 3.4rem); font-weight: 400; }
.encabezado p { color: var(--suave); margin: .5rem 0 0; }
.bloque { margin-top: 3rem; }
.bloque-cab { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem; }
.bloque-cab h2 { font-size: 1.6rem; font-weight: 400; }
.vacio { color: var(--suave); font-style: italic; }

/* Lista de cartas (compacta) */
.lista { display: grid; }
.carta-row { display: grid; grid-template-columns: 11.5rem 1fr; gap: 1rem; align-items: baseline; padding: .7rem .5rem; border-top: 1px solid var(--linea); text-decoration: none; color: inherit; transition: background .2s; }
.lista .carta-row:last-child { border-bottom: 1px solid var(--linea); }
.carta-row:hover { background: var(--hoja); }
.carta-row time { font-size: .95rem; color: var(--suave); }
.carta-row strong { display: block; font-family: var(--serif); font-size: 1.2rem; font-weight: 600; line-height: 1.3; }
.resumen { display: block; color: var(--suave); font-size: 1rem; line-height: 1.4; }

/* Carta: hoja rayada y compacta */
.hoja { max-width: 38rem; margin: 1.25rem auto 0; background: var(--hoja); border: 1px solid var(--linea); border-radius: 3px; padding: 1.4rem 1.5rem 1.6rem 3.25rem; position: relative; box-shadow: 0 1px 0 var(--linea), 0 14px 30px -18px rgba(43, 26, 51, .35); transform: rotate(-.2deg); }
.hoja::before { content: ''; position: absolute; left: 2.4rem; top: 0; bottom: 0; width: 1px; background: var(--malva); opacity: .45; }
.hoja header { margin-bottom: .9rem; }
.hoja time { display: block; color: var(--suave); font-family: var(--mano); font-size: 1.25rem; line-height: 1.4rem; }
.hoja h1 { font-size: clamp(1.6rem, 4.5vw, 2.1rem); font-weight: 400; font-style: italic; margin: .1rem 0 0; }
.hoja .prosa { font-size: 1.05rem; line-height: 1.6rem; background: repeating-linear-gradient(transparent 0 calc(1.6rem - 1px), var(--linea) calc(1.6rem - 1px) 1.6rem); }
.hoja .prosa p { margin: 0; text-indent: 1.5rem; }
.hoja .prosa p:first-child { text-indent: 0; }
.hoja .prosa p:last-child { font-family: var(--mano); font-size: 1.5rem; color: var(--malva); text-indent: 0; }
.pasar { max-width: 38rem; margin: 1.5rem auto 0; display: flex; justify-content: space-between; gap: 1rem; font-size: 1rem; }

/* Jardín */
.rejilla { display: grid; grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr)); gap: 1.25rem; }
.ficha { display: flex; flex-direction: column; overflow: hidden; background: var(--hoja); border: 1px solid var(--linea); border-top: 4px solid var(--salvia); border-radius: 6px 6px 6px 22px; text-decoration: none; color: inherit; transition: transform .2s, border-color .2s; }
.ficha[hidden] { display: none; }
.ficha:hover { transform: translateY(-3px); border-top-color: var(--malva); }
.foto { aspect-ratio: 4 / 3; overflow: hidden; background: color-mix(in srgb, var(--salvia) 14%, var(--hoja)); }
.foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
.foto-vacia { display: grid; place-items: center; height: 100%; font-family: var(--serif); font-style: italic; font-size: 4rem; color: var(--salvia); opacity: .7; }
.ficha-cuerpo { padding: 1rem 1.25rem 1.1rem; }
.ficha h3 { font-size: 1.5rem; }
.cientifico { font-style: italic; color: var(--suave); margin: .1rem 0 .75rem; font-size: 1rem; }
.ficha p { margin: 0 0 .75rem; font-size: 1.02rem; line-height: 1.55; }
.ficha .meta { display: flex; align-items: center; gap: .5rem; color: var(--suave); font-size: .95rem; margin: 0; }
.gotas { display: inline-flex; gap: .3rem; align-items: center; margin-left: auto; padding-right: .2rem; }
.datos .gotas { margin-left: .6rem; }
.gotas i { width: .6rem; height: .6rem; border: 1.5px solid var(--salvia); border-radius: 50% 0 50% 50%; transform: rotate(45deg); }
.gotas i.on { background: var(--salvia); }

/* Indicador de luz: lleno = sol, mitad = media sombra, vacío = sombra */
.luz { display: inline-block; width: .95em; height: .95em; border-radius: 50%; border: 2px solid var(--oro); vertical-align: -.1em; margin-right: .45rem; }
.luz[data-luz='sol'] { background: var(--oro); }
.luz[data-luz='media-sombra'] { background: linear-gradient(90deg, var(--oro) 50%, transparent 50%); }
.meta .luz { margin-right: 0; }

.filtros { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0 0 1.5rem; }
.filtros button { font: inherit; font-size: 1rem; cursor: pointer; padding: .4rem 1rem; border-radius: 999px; border: 1px solid var(--linea); background: var(--hoja); color: var(--tinta); }
.filtros button[aria-pressed='true'] { background: var(--salvia); border-color: var(--salvia); color: #fff; }

/* Lámina de flor */
.lamina { max-width: 44rem; margin: 1.5rem auto 0; }
.volver { font-size: 1rem; color: var(--suave); }
.lamina header { padding: 1rem 0 1rem; }
.lamina-foto { margin: 0 0 1.5rem; }
.lamina-foto .foto { aspect-ratio: 3 / 2; border-radius: 6px 6px 6px 28px; }
.lamina-foto figcaption { font-size: .85rem; color: var(--suave); margin-top: .4rem; }
.lamina h1 { font-size: clamp(2.4rem, 7vw, 3.6rem); font-weight: 400; }
.lead { font-size: 1.3rem; margin: 0 0 1rem; }
.colores { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; margin: 0; }
.colores li { border: 1px solid var(--linea); border-radius: 999px; padding: .1rem .8rem; font-size: .95rem; color: var(--suave); }
.datos { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 0; margin: 1.5rem 0 2rem; border: 1px solid var(--linea); border-radius: 6px; background: var(--hoja); }
.datos div { padding: .9rem 1.1rem; border-bottom: 1px solid var(--linea); }
.datos dt { font-size: .9rem; color: var(--suave); }
.datos dd { margin: 0; font-weight: 500; text-transform: capitalize; }
.lamina h2 { font-size: 1.6rem; font-weight: 400; margin-bottom: .75rem; }
.cuidados { padding-left: 1.2rem; margin: 0 0 2rem; }
.cuidados li { margin-bottom: .4rem; padding-left: .3rem; }
.cuidados li::marker { color: var(--salvia); }
.prosa p { margin: 0 0 1.2rem; }

@media (max-width: 560px) {
  .hoja { padding: 1.1rem 1rem 1.25rem 2.3rem; }
  .hoja::before { left: 1.6rem; }
  .carta-row { grid-template-columns: 1fr; gap: .1rem; }
  .pasar { flex-direction: column; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } html { scroll-behavior: auto; } }
